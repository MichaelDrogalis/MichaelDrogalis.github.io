<!doctype html>
<html>
  <head>
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
					      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
		     j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
		     'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
		    })(window,document,'script','dataLayer','GTM-N4V97FDR');</script>
    <!-- End Google Tag Manager -->

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ title }}">
    <title>{{ title }} — Michael Drogalis</title>

    <link href="/css/base.css" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900">
  </head>
  <body class="bg-gray-200 font-body">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N4V97FDR"
		      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <div class="container w-fit md:w-[48rem] mx-auto">
      <div class="shadow-md rounded-md bg-gray-100 my-10 p-5 md:p-10">
        {% set pos = collections.posts | readingPosition(sections, page.url) %}
        <div class="flex justify-between items-baseline gap-4 text-sm text-gray-600">
          <a class="hover:text-gray-900" href="/writing/">&larr; Writing</a>
          {% if pos %}
            <a class="hover:text-gray-900" href="/writing/#{{ pos.section | slugify }}">{{ pos.section }} &middot; {{ pos.index }} of {{ pos.total }}</a>
          {% endif %}
        </div>

        <h1 class="text-2xl md:text-4xl text-gray-900 mt-6 mb-2">{{ title }}</h1>

        <time class="block text-sm text-gray-600 mt-2" datetime="{{ page.date.toISOString().slice(0, 10) }}">{{ page.date | readableDate }}</time>

        {% if tags %}
          <ul class="flex flex-wrap gap-2 mt-4">
            {% for tag in tags %}
              <li class="rounded-lg text-slate-200 bg-violet-800 px-2 py-1 text-xs">{{ tag }}</li>
            {% endfor %}
          </ul>
        {% endif %}

        <div class="prose content mt-8">
          {{ content | safe }}
        </div>

        {% if pos and (pos.prev or pos.next) %}
          <nav class="mt-12 pt-6 border-t border-gray-300 grid grid-cols-1 md:grid-cols-2 gap-4">
            {% if pos.prev %}
              <a class="group block rounded-md p-4 hover:bg-gray-200" href="{{ pos.prev.post.url }}">
                <span class="block text-xs text-gray-500">&larr; Previous{% if pos.prev.section != pos.section %} in {{ pos.prev.section }}{% endif %}</span>
                <span class="block mt-1 font-semibold text-gray-900 group-hover:underline">{{ pos.prev.post.data.title }}</span>
              </a>
            {% else %}
              <div class="hidden md:block"></div>
            {% endif %}
            {% if pos.next %}
              <a class="group block rounded-md p-4 hover:bg-gray-200 md:text-right" href="{{ pos.next.post.url }}">
                <span class="block text-xs text-gray-500">Next{% if pos.next.section != pos.section %} in {{ pos.next.section }}{% endif %} &rarr;</span>
                <span class="block mt-1 font-semibold text-gray-900 group-hover:underline">{{ pos.next.post.data.title }}</span>
              </a>
            {% endif %}
          </nav>
        {% endif %}
      </div>
    </div>
  </body>
</html>
